.env
CLAUDE.md
config/hypr/displays.lua.revert
# Per-machine state written at runtime (bar edge, Display settings).
config/hypr/barorientation.lua
config/hypr/displays.lua

# Which theme is active: written by apply-theme.sh on every switch, and by
# its --init mode (run from modules/user) on a fresh install.
config/hypr/theme.lua
config/kitty/theme.conf
config/tmux/theme.conf
config/nvim/theme_name.txt
config/cava/themes/current
config/btop/themes/nixcraft.theme
config/yazi/flavors/nixcraft.yazi/flavor.toml
config/wayclick/.active_pack
# The dynamic theme is generated by matugen from the wallpaper; edit
# config/matugen/templates instead. The folder stays so it can be picked.
config/themes/dynamic/*
!config/themes/dynamic/.gitkeep
config/nvim/colors/dynamic.lua
# Written by the HyprMod settings app (an empty one is made on first run).
config/hypr/hyprland-gui.lua
todo.txt
