# Yazi flavor — dynamic (generated by matugen)
# Installed as ~/.config/yazi/flavors/nixcraft.yazi/flavor.toml by apply-theme.sh.
# Overrides only the style colors; icon/filetype tables stay in theme.toml.

[app]
overall = {}

[mgr]
cwd = { fg = "{{colors.primary.default.hex}}" }

find_keyword  = { fg = "{{colors.tertiary.default.hex}}", bold = true, italic = true, underline = true }
find_position = { fg = "{{colors.secondary.default.hex}}", bg = "reset", bold = true, italic = true }

symlink_target = { italic = true }

marker_copied   = { fg = "{{colors.secondary.default.hex}}", bg = "{{colors.secondary.default.hex}}" }
marker_cut      = { fg = "{{colors.error.default.hex}}", bg = "{{colors.error.default.hex}}" }
marker_marked   = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.primary.default.hex}}" }
marker_selected = { fg = "{{colors.tertiary.default.hex}}", bg = "{{colors.tertiary.default.hex}}" }
marker_symbol   = "│"

count_copied   = { fg = "{{colors.surface.default.hex}}", bg = "{{colors.secondary.default.hex}}" }
count_cut      = { fg = "{{colors.surface.default.hex}}", bg = "{{colors.error.default.hex}}" }
count_selected = { fg = "{{colors.surface.default.hex}}", bg = "{{colors.tertiary.default.hex}}" }

border_symbol = "│"
border_style  = { fg = "{{colors.outline_variant.default.hex}}" }

syntect_theme = ""

[tabs]
active   = { bg = "{{colors.primary.default.hex}}", bold = true }
inactive = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.outline_variant.default.hex}}" }

sep_inner = { open = "", close = "" }
sep_outer = { open = "", close = "" }

[mode]
normal_main = { bg = "{{colors.primary.default.hex}}", bold = true }
normal_alt  = { fg = "{{colors.primary.default.hex}}", bg = "{{colors.outline_variant.default.hex}}" }

select_main = { bg = "{{colors.error.default.hex}}", bold = true }
select_alt  = { fg = "{{colors.error.default.hex}}", bg = "{{colors.outline_variant.default.hex}}" }

unset_main = { bg = "{{colors.error.default.hex}}", bold = true }
unset_alt  = { fg = "{{colors.error.default.hex}}", bg = "{{colors.outline_variant.default.hex}}" }

[indicator]
parent  = { reversed = true }
current = { reversed = true }
preview = { underline = true }
padding = { open = "", close = "" }

[status]
overall   = {}
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

perm_sep   = { fg = "{{colors.outline_variant.default.hex}}" }
perm_type  = { fg = "{{colors.secondary.default.hex}}" }
perm_read  = { fg = "{{colors.tertiary.default.hex}}" }
perm_write = { fg = "{{colors.error.default.hex}}" }
perm_exec  = { fg = "{{colors.primary.default.hex}}" }

progress_label  = { bold = true }
progress_normal = { fg = "{{colors.secondary.default.hex}}", bg = "{{colors.surface_container.default.hex}}" }
progress_error  = { fg = "{{colors.tertiary.default.hex}}", bg = "{{colors.error.default.hex}}" }

[which]
cols            = 3
mask            = { bg = "{{colors.surface_container.default.hex}}" }
cand            = { fg = "{{colors.primary.default.hex}}" }
rest            = { fg = "{{colors.outline_variant.default.hex}}" }
desc            = { fg = "{{colors.tertiary.default.hex}}" }
separator       = "  "
separator_style = { fg = "{{colors.outline_variant.default.hex}}" }

[confirm]
border     = { fg = "{{colors.primary.default.hex}}" }
title      = { fg = "{{colors.primary.default.hex}}" }
body       = {}
list       = {}
btn_yes    = { reversed = true }
btn_no     = {}
btn_labels = [ "  [Y]es  ", "  (N)o  " ]

[spot]
border = { fg = "{{colors.primary.default.hex}}" }
title  = { fg = "{{colors.primary.default.hex}}" }

tbl_col  = { fg = "{{colors.primary.default.hex}}" }
tbl_cell = { fg = "{{colors.tertiary.default.hex}}", reversed = true }

[notify]
title_info  = { fg = "{{colors.secondary.default.hex}}" }
title_warn  = { fg = "{{colors.tertiary.default.hex}}" }
title_error = { fg = "{{colors.error.default.hex}}" }

icon_info  = ""
icon_warn  = ""
icon_error = ""

[pick]
border   = { fg = "{{colors.primary.default.hex}}" }
active   = { fg = "{{colors.tertiary.default.hex}}", bold = true }
inactive = {}

[input]
border   = { fg = "{{colors.primary.default.hex}}" }
title    = {}
value    = {}
selected = { reversed = true }

[cmp]
border   = { fg = "{{colors.primary.default.hex}}" }
active   = { reversed = true }
inactive = {}

icon_file    = ""
icon_folder  = ""
icon_command = ""

[tasks]
border  = { fg = "{{colors.primary.default.hex}}" }
title   = {}
hovered = { fg = "{{colors.tertiary.default.hex}}", bold = true }

[help]
on      = { fg = "{{colors.primary.default.hex}}" }
run     = { fg = "{{colors.tertiary.default.hex}}" }
desc    = {}
hovered = { reversed = true, bold = true }
footer  = { fg = "{{colors.surface_container.default.hex}}", bg = "{{colors.on_surface.default.hex}}" }
